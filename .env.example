# ==============================================================================
# AI CALLING CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# ==============================================================================
# SUPABASE CONFIGURATION (Required)
# ==============================================================================
# Get these from your Supabase Dashboard > Settings > API
# Project: https://supabase.com/dashboard/project/[YOUR_PROJECT_ID]/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/keys

# ==============================================================================
# SUPABASE MCP INTEGRATION (Required for AI Assistant Integration)
# ==============================================================================
# Personal Access Token from: https://supabase.com/dashboard/account/tokens
# Generate new token with name: "AI Assistant MCP Server"
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token_here

# ==============================================================================
# STRIPE CONFIGURATION (Optional - for billing features)
# ==============================================================================
# Get these from your Stripe Dashboard > Developers > API keys
# Use test keys for development: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==============================================================================
# API & APPLICATION CONFIGURATION
# ==============================================================================
# Server port for core-api service
PORT=3001

# Base URL for your frontend (used for redirects, webhooks, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
WEB_BASE_URL=http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION (Optional - usually handled by Supabase)
# ==============================================================================
# Only needed for direct PostgreSQL connections
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

# ==============================================================================
# GOOGLE CLOUD CONFIGURATION (For deployment)
# ==============================================================================
# Only needed for Google Cloud deployment
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1