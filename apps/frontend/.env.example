# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# These are PUBLIC variables that will be included in the client-side bundle

# ==============================================================================
# SUPABASE PUBLIC CONFIGURATION (Required)
# ==============================================================================
# Get these from your Supabase Dashboard > Settings > API
# These are safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# ==============================================================================
# NEXT.JS CONFIGURATION
# ==============================================================================
# Set to 'development' for local dev, 'production' for deployment
NODE_ENV=development

# ==============================================================================
# API ENDPOINTS (Optional - defaults to localhost in development)
# ==============================================================================
# URL for your core-api service
# Development: http://localhost:3001
# Production: https://your-api-domain.com
# NEXT_PUBLIC_API_URL=http://localhost:3001